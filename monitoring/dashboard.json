{
  "title": "Runbook Service Health",
  "uid": "runbook-health",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(runbook_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx errors / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(runbook_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 API response time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(runbook_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Runbook answers / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome,method) (rate(runbook_retrieval_total[5m]))",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Authentication failures / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(runbook_auth_failures_total[5m])",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Possible duplicate flags / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (flagged) (rate(similar_requests_total[5m]))",
          "legendFormat": "{{flagged}} {{mode}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Grounded answers by mode / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(llm_requests_total[5m]))",
          "legendFormat": "{{flagged}} {{mode}}"
        }
      ]
    }
  ]
}
